{
    "name": "acmls/block-attendanceleaderboard",
    "description": "Adaptive Cognitive-Motivational Learning System (ACMLS) - Moodle Block Plugin",
    "type": "moodle-block",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "giorgiosironi/eris": "^0.14.0"
    },
    "autoload": {
        "psr-4": {
            "block_attendanceleaderboard\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "block_attendanceleaderboard\\tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
