{{!
    Template: manage_resources.mustache
    Package:  block_attendanceleaderboard
    Purpose:  Table listing all learning resources with usage statistics and action buttons.

    Context variables:
      - courseid          (int)    Current course ID.
      - manage_url        (string) Base URL for manage_resources.php.
      - has_resources     (bool)   Whether there are any resources to display.
      - resources         (array)  Array of resource objects:
            - id                  (int)
            - title               (string)
            - resource_type       (string)
            - resource_type_label (string)
            - difficulty_level    (int)
            - difficulty_label    (string)
            - difficulty_class    (string)  Bootstrap badge class.
            - access_count        (int)
            - avg_rating          (string)  Formatted to 2 decimals or '—'.
            - effectiveness_score (string)  Formatted to 2 decimals or '—'.
            - is_active           (bool)
            - is_active_label     (string)
            - is_active_class     (string)  Bootstrap badge class.
            - edit_url            (string)
            - delete_url          (string)
            - delete_confirm      (string)  JS confirm message.
      - add_url           (string) URL to add a new resource.
      - sesskey           (string) Moodle session key for CSRF protection.
      - no_resources_msg  (string) Message when no resources exist.
}}
<div class="block-attendanceleaderboard-manage-resources">

    {{! Page header with Add button }}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">{{#str}}manage_resources_title, block_attendanceleaderboard{{/str}}</h4>
        <a href="{{{add_url}}}" class="btn btn-primary btn-sm">
            <i class="fa fa-plus" aria-hidden="true"></i>
            {{#str}}addresource, block_attendanceleaderboard{{/str}}
        </a>
    </div>

    {{#has_resources}}
    <div class="table-responsive">
        <table class="table table-striped table-hover generaltable">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">{{#str}}resource_title, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col">{{#str}}resource_type, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col">{{#str}}difficulty_level, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col" class="text-right">{{#str}}access_count, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col" class="text-right">{{#str}}avg_rating, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col" class="text-right">{{#str}}effectiveness_score, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}resource_status, block_attendanceleaderboard{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}actions, block_attendanceleaderboard{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#resources}}
                <tr>
                    <td>
                        <strong>{{title}}</strong>
                    </td>
                    <td>
                        <span class="badge badge-secondary">{{resource_type_label}}</span>
                    </td>
                    <td>
                        <span class="badge badge-{{difficulty_class}}">{{difficulty_label}}</span>
                    </td>
                    <td class="text-right">
                        {{access_count}}
                    </td>
                    <td class="text-right">
                        {{avg_rating}}
                    </td>
                    <td class="text-right">
                        {{effectiveness_score}}
                    </td>
                    <td class="text-center">
                        <span class="badge badge-{{is_active_class}}">{{is_active_label}}</span>
                    </td>
                    <td class="text-center text-nowrap">
                        <a href="{{{edit_url}}}"
                           class="btn btn-sm btn-outline-primary"
                           title="{{#str}}editresource, block_attendanceleaderboard{{/str}}">
                            <i class="fa fa-pencil" aria-hidden="true"></i>
                            <span class="sr-only">{{#str}}editresource, block_attendanceleaderboard{{/str}}</span>
                        </a>
                        <a href="{{{delete_url}}}"
                           class="btn btn-sm btn-outline-danger"
                           title="{{#str}}deleteresource, block_attendanceleaderboard{{/str}}"
                           onclick="return confirm('{{delete_confirm}}');">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                            <span class="sr-only">{{#str}}deleteresource, block_attendanceleaderboard{{/str}}</span>
                        </a>
                    </td>
                </tr>
                {{/resources}}
            </tbody>
        </table>
    </div>
    {{/has_resources}}

    {{^has_resources}}
    <div class="alert alert-info" role="alert">
        <i class="fa fa-info-circle" aria-hidden="true"></i>
        {{no_resources_msg}}
    </div>
    {{/has_resources}}

</div>
