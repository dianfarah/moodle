{{!
    @template block_attendanceleaderboard/consent_dialog

    Consent dialog modal for ACMLS. Displayed before sending anonymised
    learner data to an external LLM service for motivational content generation.

    Context variables required for this template:
    * userid             - int, current user ID
    * courseid           - int, current course ID
    * str_title          - string, dialog title
    * str_body           - string, dialog body text
    * str_agree          - string, agree button label
    * str_decline        - string, decline button label
    * str_notice         - string, notice text shown below buttons
}}
<div class="modal fade acmls-consent-modal"
     id="acmlsConsentModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="acmlsConsentModalLabel"
     aria-modal="true"
     data-userid="{{userid}}"
     data-courseid="{{courseid}}"
     data-backdrop="static"
     data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="acmlsConsentModalLabel">
                    <i class="fa fa-shield mr-2" aria-hidden="true"></i>
                    {{str_title}}
                </h5>
            </div>

            <div class="modal-body">
                <div class="acmls-consent-body">
                    <p>{{str_body}}</p>

                    <div class="card bg-light mb-3">
                        <div class="card-body py-2 px-3">
                            <ul class="mb-0 pl-3 small">
                                <li>{{#str}}consent_data_item_performance, block_attendanceleaderboard{{/str}}</li>
                                <li>{{#str}}consent_data_item_motivation, block_attendanceleaderboard{{/str}}</li>
                                <li>{{#str}}consent_data_item_style, block_attendanceleaderboard{{/str}}</li>
                                <li>{{#str}}consent_data_item_engagement, block_attendanceleaderboard{{/str}}</li>
                            </ul>
                        </div>
                    </div>

                    <p class="text-muted small">
                        <i class="fa fa-lock mr-1" aria-hidden="true"></i>
                        {{#str}}consent_anonymization_notice, block_attendanceleaderboard{{/str}}
                    </p>
                </div>
            </div>

            <div class="modal-footer flex-column align-items-stretch">
                <div class="d-flex justify-content-between mb-2">
                    <button type="button"
                            class="btn btn-success acmls-consent-agree flex-fill mr-2"
                            data-userid="{{userid}}"
                            data-courseid="{{courseid}}">
                        <i class="fa fa-check mr-1" aria-hidden="true"></i>
                        {{str_agree}}
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary acmls-consent-decline flex-fill"
                            data-userid="{{userid}}"
                            data-courseid="{{courseid}}">
                        <i class="fa fa-times mr-1" aria-hidden="true"></i>
                        {{str_decline}}
                    </button>
                </div>
                <p class="text-muted small text-center mb-0">
                    <i class="fa fa-info-circle mr-1" aria-hidden="true"></i>
                    {{str_notice}}
                </p>
            </div>

        </div>
    </div>
</div>
