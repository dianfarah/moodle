{{!
    @template block_attendanceleaderboard/quiz_motivation

    AI Motivation popup shown after the learner submits a quiz attempt.
    Delivers personalized encouraging message generated by Gemini AI / template.
}}
<div class="acmls-motivation-popup acmls-quiz-motivation-popup is-visible"
     data-userid="{{userid}}"
     data-courseid="{{courseid}}"
     data-recordid="{{recordid}}"
     data-category="{{category}}"
     data-source="{{source}}">
    <div class="acmls-motivation-popup__backdrop"></div>
    <div class="acmls-motivation-popup__dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="acmls-quiz-mot-title-{{userid}}">
        <div class="acmls-motivation-popup__header bg-primary text-white p-3 rounded-top">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge badge-light text-primary mb-1">{{category_label}}</span>
                    <h3 id="acmls-quiz-mot-title-{{userid}}" class="acmls-motivation-popup__title text-white m-0 font-weight-bold">
                        {{str_title}}
                    </h3>
                    <small class="text-white-50">{{str_subtitle}}</small>
                </div>
            </div>
        </div>

        <div class="acmls-motivation-popup__body p-4">
            {{#has_quizgrade}}
            <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center">
                <strong>{{quizgrade_formatted}}</strong>
            </div>
            {{/has_quizgrade}}

            <div class="acmls-motivation-message-box p-3 mb-3 rounded" style="background: #f0fdf4; border-left: 4px solid #22c55e;">
                <p class="acmls-motivation-popup__message m-0 font-italic" style="font-size: 1.05rem; line-height: 1.6; color: #166534;">
                    "{{content}}"
                </p>
            </div>

            {{#has_suggestion}}
            <div class="acmls-motivation-suggestion-box p-3 mb-3 rounded" style="background: #f0f9ff; border-left: 4px solid #0284c7;">
                <div class="font-weight-bold mb-1" style="color: #0369a1; font-size: 0.95rem;">
                    <i class="fa fa-lightbulb-o mr-1" aria-hidden="true"></i> {{str_suggestion_title}}
                </div>
                <p class="acmls-motivation-popup__suggestion m-0" style="font-size: 0.95rem; line-height: 1.6; color: #0f172a;">
                    {{suggestion}}
                </p>
            </div>
            {{/has_suggestion}}

            {{#is_gemini}}
            <div class="d-flex align-items-center mb-3 text-muted small">
                <span>Dihasilkan oleh AI Gemini secara adaptif berdasarkan capaianmu.</span>
            </div>
            {{/is_gemini}}

            <button type="button" class="btn btn-success btn-lg w-100 acmls-quiz-motivation__dismiss">
                {{str_continue}}
            </button>
        </div>
    </div>
</div>
<script>
    (function() {
        var el = document.querySelector('.acmls-quiz-motivation-popup');
        if (el && el.parentNode !== document.body) {
            document.body.appendChild(el);
        }
    })();
</script>
